# Copy to .env.local. Names only — never commit real values.

# Public site URL (used for canonical URLs, share links, RSS).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where content is read from. Phase 1 supports "local" only.
CONTENT_SOURCE=local
# Directory (relative to the project root) that mirrors the content repository layout.
CONTENT_DIR=content
