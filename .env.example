# Copy to .env.local. Names only — never commit real values.

# Public site URL (used for canonical URLs, share links, RSS).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where content lives: "local" (the folder below) or "github".
CONTENT_SOURCE=local
# local: directory (relative to the project root, or absolute) that mirrors the content repository layout.
CONTENT_DIR=content

# --- GitHub content source (CONTENT_SOURCE=github) ---------------------------
# Repository holding the content, e.g. you/blog-content (keep it private: drafts live there).
CONTENT_REPO=
CONTENT_BRANCH=main
# Folder inside the repository that contains posts/, pages/ and taxonomy.yml ("" = repository root).
CONTENT_REPO_PATH=
# Fine-grained personal access token limited to CONTENT_REPO with "Contents: Read and write".
# Server-only: never prefix with NEXT_PUBLIC_.
CONTENT_GITHUB_TOKEN=
# Secret for the repository's push webhook → <your site>/api/webhooks/github (content type: application/json).
GITHUB_WEBHOOK_SECRET=
# Only for GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Admin sign-in (Auth.js + GitHub OAuth) ---------------------------------
# Random secret used to encrypt session cookies: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# GitHub OAuth App → https://github.com/settings/developers
# Callback URL: <your site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated numeric GitHub user IDs allowed into /admin.
# Find yours at https://api.github.com/users/<your-login> ("id" field).
ADMIN_GITHUB_IDS=
