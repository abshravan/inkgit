# Copy to .env.local. Names only — never commit real values.

# Public site URL (canonical URLs, share links, RSS). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same origin, read at runtime (used by proxy.ts for trusted internal lookups). Optional.
SITE_URL=

# Where content lives: "local" (the folder below) or "github".
CONTENT_SOURCE=local
# local: directory (relative to the project root, or absolute) that mirrors the content repository layout.
CONTENT_DIR=content

# --- GitHub content source (CONTENT_SOURCE=github) ---------------------------
# Repository holding the content, e.g. you/blog-content (keep it private: drafts live there).
CONTENT_REPO=
CONTENT_BRANCH=main
# Folder inside the repository that contains posts/, pages/ and taxonomy.yml ("" = repository root).
CONTENT_REPO_PATH=
# Option A: fine-grained personal access token limited to CONTENT_REPO with "Contents: Read and write".
# Server-only: never prefix with NEXT_PUBLIC_.
CONTENT_GITHUB_TOKEN=
# Option B (recommended for production): a GitHub App installed on CONTENT_REPO with
# "Contents: Read and write". Tokens are short-lived and scoped to that repository.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM private key; newlines may be written as \n.
GITHUB_APP_PRIVATE_KEY=
# Secret for the repository's push webhook → <your site>/api/webhooks/github (content type: application/json).
GITHUB_WEBHOOK_SECRET=
# Only for GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Admin sign-in (Auth.js + GitHub OAuth) ---------------------------------
# In production also set AUTH_URL=https://<your domain> (Auth.js callback base).
# Random secret used to encrypt session cookies: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# GitHub OAuth App → https://github.com/settings/developers
# Callback URL: <your site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated numeric GitHub user IDs allowed into /admin.
# Find yours at https://api.github.com/users/<your-login> ("id" field).
ADMIN_GITHUB_IDS=

# --- Media (image uploads) -----------------------------------------------------
# "local" stores files in MEDIA_DIR (served at /media/...; single-server/dev only),
# "s3" uses any S3-compatible bucket, e.g. Cloudflare R2.
MEDIA_STORAGE=local
MEDIA_DIR=media-uploads
# Upload limit in bytes (default 5 MB, max 20 MB).
MEDIA_MAX_BYTES=5242880
# S3 / R2 (MEDIA_STORAGE=s3). R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (custom domain or r2.dev URL), https only.
MEDIA_PUBLIC_URL=

# --- Analytics (optional, cookie-less) -----------------------------------------
# Plausible (or a compatible script). Leave empty to disable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
